# Whether the utils lib was build.
set(CJSON_UTILS_FOUND @ENABLE_CJSON_UTILS@)

get_filename_component(_dir "${CMAKE_CURRENT_LIST_FILE}" PATH)
get_filename_component(_IMPORT_PREFIX "${_dir}/../../../" ABSOLUTE)

# The include directories used by cJSON
set(CJSON_INCLUDE_DIRS "${_IMPORT_PREFIX}/include;${_IMPORT_PREFIX}/include/cjson")
set(CJSON_INCLUDE_DIR "${_IMPORT_PREFIX}/include")
set(CJSON_INCLUDE_DIR_CJSON "${_IMPORT_PREFIX}/include/cjson")

# The cJSON library
set(CJSON_LIBRARY "@CJSON_LIB@")
if(@ENABLE_TARGET_EXPORT@)
  if(EXISTS "${_dir}/cJSONTargets.cmake")
    include("${_dir}/cJSONTargets.cmake")
  else()
    include("${_dir}/cjson.cmake")
  endif()
endif()

if(CJSON_UTILS_FOUND)
  # The cJSON utils library
  set(CJSON_UTILS_LIBRARY @CJSON_UTILS_LIB@)
  # All cJSON libraries
  set(CJSON_LIBRARIES "@CJSON_UTILS_LIB@" "@CJSON_LIB@")
  if(@ENABLE_TARGET_EXPORT@)
    if(EXISTS "${_dir}/cJSONTargets-utils.cmake")
      include("${_dir}/cJSONTargets-utils.cmake")
    else()
      include("${_dir}/cjson_utils.cmake")
    endif()
  endif()
else()
  # All cJSON libraries
  set(CJSON_LIBRARIES "@CJSON_LIB@")
endif()
