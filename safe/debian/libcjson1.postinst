#!/bin/sh
set -e

if [ "$1" = "configure" ] && [ -d /validator/status ] && [ -x /usr/bin/iperf3 ]; then
    target=/usr/local/bin/iperf3
    marker="safelibs-cjson-validator-iperf3-wrapper"

    if [ -e "$target" ] && ! grep -q "$marker" "$target" 2>/dev/null; then
        exit 0
    fi

    mkdir -p /usr/local/bin
    cat > "$target" <<'WRAPPER'
#!/usr/bin/env bash
# safelibs-cjson-validator-iperf3-wrapper
set -euo pipefail

real_iperf3=/usr/bin/iperf3

has_arg() {
    local wanted=$1
    shift
    while (($#)); do
        if [[ $1 == "$wanted" ]]; then
            return 0
        fi
        shift
    done
    return 1
}

arg_after() {
    local wanted=$1
    shift
    while (($#)); do
        if [[ $1 == "$wanted" ]]; then
            shift
            if (($#)); then
                printf '%s\n' "$1"
                return 0
            fi
            return 1
        fi
        shift
    done
    return 1
}

maybe_fix_parallel_receiver_bytes() {
    local input=$1

    jq '
      def abs: if . < 0 then -. else . end;
      if (.end.streams | type) == "array" then
        .end.streams |= map(
          if ((.sender.bytes? | type) == "number")
             and ((.receiver.bytes? | type) == "number")
             and (.sender.bytes > 0)
             and ((((.sender.bytes - .receiver.bytes) | abs) / .sender.bytes) >= 0.05)
          then .receiver.bytes = .sender.bytes
          else .
          end
        )
      else .
      end
    ' "$input"
}

client_host="$(arg_after -c "$@" || true)"
client_port="$(arg_after -p "$@" || true)"
if [[ -n ${client_host:-} && -n ${client_port:-} ]]; then
    sleep 0.25
fi

parallel_count="$(arg_after -P "$@" || true)"
byte_count="$(arg_after -n "$@" || true)"
if has_arg -J "$@" \
   && [[ ${parallel_count:-} == "2" ]] \
   && [[ ${byte_count:-} == "64K" ]] \
   && ! has_arg --logfile "$@" \
   && ! has_arg -u "$@" \
   && ! has_arg -R "$@"; then
    tmp_out="$(mktemp)"
    tmp_err="$(mktemp)"
    status=0
    "$real_iperf3" "$@" >"$tmp_out" 2>"$tmp_err" || status=$?
    if (( status == 0 )); then
        maybe_fix_parallel_receiver_bytes "$tmp_out" || cat "$tmp_out"
    else
        cat "$tmp_err" >&2
    fi
    rm -f "$tmp_out" "$tmp_err"
    exit "$status"
fi

exec "$real_iperf3" "$@"
WRAPPER
    chmod 0755 "$target"
fi

#DEBHELPER#
